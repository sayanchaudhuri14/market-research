# Copy to .env and fill in values

# Path to the kite_token.json written daily by the gap trading cron
# Paper trader reads this — it never generates its own token
KITE_TOKEN_PATH=/home/ubuntu/gap_trading/cron/v2/../kite_token.json

# Your Kite Connect API key (same as gap trading)
KITE_API_KEY=your_api_key_here

# Where to store paper trade logs and strategy state
OPTIONS_LOG_DIR=./logs

# Starting capital per strategy (Rs)
OPTIONS_STARTING_CAPITAL=100000
